#include <stdlib.h>
#include <stdbool.h>

typedef struct {
    int to;
    int direction;
} FlatEdge;

int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    int* deg = (int*)calloc(n, sizeof(int));
    for (int i = 0; i < connectionsSize; i++) {
        deg[connections[i][0]]++;
        deg[connections[i][1]]++;
    }

    int* headIdx = (int*)malloc((n + 1) * sizeof(int));
    headIdx[0] = 0;
    for (int i = 0; i < n; i++) {
        headIdx[i + 1] = headIdx[i] + deg[i];
    }

    int* currentOffset = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        currentOffset[i] = headIdx[i];
    }

    FlatEdge* edges = (FlatEdge*)malloc(2 * connectionsSize * sizeof(FlatEdge));
    for (int i = 0; i < connectionsSize; i++) {
        int u = connections[i][0];
        int v = connections[i][1];

        int posU = currentOffset[u]++;
        edges[posU].to = v;
        edges[posU].direction = 1;

        int posV = currentOffset[v]++;
        edges[posV].to = u;
        edges[posV].direction = 0;
    }

    bool* visited = (bool*)calloc(n, sizeof(bool));
    int* queue = (int*)malloc(n * sizeof(int));
    int head = 0, tail = 0;

    queue[tail++] = 0;
    visited[0] = true;
    int changeCount = 0;

    while (head < tail) {
        int curr = queue[head++];
        int start = headIdx[curr];
        int end = headIdx[curr + 1];

        for (int i = start; i < end; i++) {
            int nextNode = edges[i].to;
            if (!visited[nextNode]) {
                visited[nextNode] = true;
                changeCount += edges[i].direction;
                queue[tail++] = nextNode;
            }
        }
    }

    free(deg);
    free(headIdx);
    free(currentOffset);
    free(edges);
    free(visited);
    free(queue);

    return changeCount;
}
