#define INF 1e9

int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    int* dist = (int*)malloc(n * sizeof(int));
    int* nextDist = (int*)malloc(n * sizeof(int));
    
    for (int i = 0; i < n; i++) {
        dist[i] = INF;
    }
    dist[src] = 0;

    for (int i = 0; i <= k; i++) {
        memcpy(nextDist, dist, n * sizeof(int));
        
        for (int j = 0; j < flightsSize; j++) {
            int u = flights[j][0];
            int v = flights[j][1];
            int price = flights[j][2];
            
            if (dist[u] != INF && dist[u] + price < nextDist[v]) {
                nextDist[v] = dist[u] + price;
            }
        }
        
        int* temp = dist;
        dist = nextDist;
        nextDist = temp;
    }

    int result = dist[dst] == INF ? -1 : dist[dst];
    
    free(dist);
    free(nextDist);
    
    return result;
}
